<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Company.Companyjobdetail.fragment_company_add_jobs_4">

    <LinearLayout
        android:id="@+id/layout_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <!-- Section tes  -->
        <LinearLayout
            android:id="@+id/compny_rearrange_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="1">

                <TextView
                    android:id="@+id/compny_tes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Tes"
                    android:textColor="@color/dark_100"
                    android:textSize="16sp" />

                <!--                <TextView-->
                <!--                    android:id="@+id/btn_compny_tes_rearrange"-->
                <!--                    android:layout_width="wrap_content"-->
                <!--                    android:layout_height="wrap_content"-->
                <!--                    android:clickable="true"-->
                <!--                    android:focusable="true"-->
                <!--                    android:fontFamily="@font/poppins_semibold"-->
                <!--                    android:text="Rearrange"-->
                <!--                    android:textColor="@color/danger_500"-->
                <!--                    android:textSize="14sp" />-->
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/layout_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="ScrollViewCount">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </androidx.core.widget.NestedScrollView>

    <androidx.percentlayout.widget.PercentRelativeLayout
        android:id="@+id/layout_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="50dp"
        android:background="@color/white"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_kembali_cmpny"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/white"
            android:fontFamily="@font/poppins"
            android:text="Kembali"
            android:textAllCaps="false"
            android:textColor="@color/danger_500"
            android:textSize="14sp"
            app:cornerRadius="100dp"
            app:layout_widthPercent="45%"
            app:strokeColor="@color/danger_500"
            app:strokeWidth="1dp"
            tools:layout_editor_absoluteX="17dp"
            tools:layout_editor_absoluteY="346dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_selanjutnya_cmpny"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/white"
            android:fontFamily="@font/poppins"
            android:text="Selanjutnya"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textColor="@color/danger_500"
            android:textSize="14sp"
            app:cornerRadius="100dp"
            app:iconTint="@color/danger_500"
            app:layout_widthPercent="45%"
            app:strokeColor="@color/danger_500"
            app:strokeWidth="1dp"
            tools:layout_editor_absoluteX="17dp"
            tools:layout_editor_absoluteY="346dp" />
    </androidx.percentlayout.widget.PercentRelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>