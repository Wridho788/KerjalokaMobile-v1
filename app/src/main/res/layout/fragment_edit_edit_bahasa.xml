<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:card_view="http://schemas.android.com/tools"
    android:layout_centerInParent="true"
    android:layout_gravity="top">

    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:fitsSystemWindows="true"
        app:layout_constraintHeight_percent="80"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/mainAppbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:elevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3.Button.Icon"
                    android:backgroundTint="@color/white"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:paddingLeft="16dp"
                    app:cornerRadius="100sp"
                    app:icon="@drawable/ic_back"
                    app:iconTint="@color/danger_500"/>

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/mainToolbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:titleTextColor="@color/black"
                    app:title="Edit Lampiran"
                    android:layout_gravity="center"/>

            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/show_sheet_manage_lampiran"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:layout_marginBottom="32dp"
                    android:orientation="vertical"
                    android:textAlignment="center">

                    <LinearLayout
                        android:id="@+id/bahasa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        tools:ignore="MissingConstraints">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:fontFamily="@font/poppins"
                            android:layout_marginTop="10dp"
                            android:text="Bahasa"
                            android:textColor="@color/dark_100"
                            android:textSize="14dp" />

                        <EditText
                            android:id="@+id/insert_bahasa"
                            android:layout_marginTop="6dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_marginRight="16dp"
                            android:height="40dp"
                            android:background="@color/light_300"
                            android:fontFamily="@font/poppins"
                            android:gravity="top"
                            android:hint="Pilih Bahasa"
                            android:inputType="text|textMultiLine"
                            android:lines="8"
                            android:maxLines="10"
                            android:paddingLeft="4dp"
                            android:paddingTop="12dp"
                            android:scrollbars="horizontal"
                            android:textSize="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">


                            <androidx.percentlayout.widget.PercentRelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    app:layout_widthPercent="48%">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/poppins"
                                        android:text="Tingkat Lisan"
                                        android:textColor="@color/dark_100">
                                    </TextView>

                                    <com.google.android.material.card.MaterialCardView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="8dp"
                                        android:backgroundTint="@color/light_500"
                                        android:clickable="false"
                                        android:elevation="0dp"
                                        app:cardCornerRadius="50dp"
                                        app:cardElevation="0dp">

                                        <EditText
                                            android:id="@+id/plh_lisan_bahasa"
                                            android:layout_width="match_parent"
                                            android:layout_height="40dp"
                                            android:background="@color/light_300"
                                            android:ems="10"
                                            android:hint="Masukkan skor"
                                            android:inputType="textMultiLine|text"
                                            android:lines="10"
                                            android:maxLines="10"
                                            android:paddingLeft="8dp"
                                            android:textColor="@color/trueGray_300"
                                            android:textSize="10sp" />
                                    </com.google.android.material.card.MaterialCardView>

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:orientation="vertical"
                                    app:layout_widthPercent="48%">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/poppins"
                                        android:text="Tingkat Tertulis"
                                        android:textColor="@color/dark_100">

                                    </TextView>

                                    <com.google.android.material.card.MaterialCardView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="8dp"
                                        android:backgroundTint="@color/light_500"
                                        android:clickable="false"
                                        android:elevation="0dp"
                                        app:cardCornerRadius="50dp"
                                        app:cardElevation="0dp">

                                        <EditText
                                            android:id="@+id/plh_terrtulis_bahasa"
                                            android:layout_width="match_parent"
                                            android:layout_height="40dp"
                                            android:background="@color/light_300"
                                            android:ems="10"
                                            android:hint="Masukkan skor"
                                            android:inputType="textMultiLine|text"
                                            android:lines="10"
                                            android:maxLines="10"
                                            android:paddingLeft="8dp"
                                            android:textColor="@color/trueGray_300"
                                            android:textSize="10sp" />
                                    </com.google.android.material.card.MaterialCardView>

                                </LinearLayout>
                            </androidx.percentlayout.widget.PercentRelativeLayout>



                        </LinearLayout>



                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_tmbh_bahasa"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="top"
                            android:layout_marginLeft="16dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginRight="16dp"
                            android:backgroundTint="@color/white"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Tambah Bahasa"
                            android:textAllCaps="false"
                            android:textColor="@color/danger_500"
                            android:textSize="14dp"
                            app:cornerRadius="100dp"
                            app:strokeColor="@color/danger_500"
                            app:strokeWidth="1dp"
                            tools:layout_editor_absoluteX="17dp"
                            tools:layout_editor_absoluteY="346dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_marginTop="10dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        tools:ignore="UselessParent">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_bahasa_kamu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:checkable="true"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="10dp"
                            app:strokeColor="@color/light_500"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="vertical"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="16dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/bahasa_pelamar"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/poppins_semibold"
                                        android:text="Bahasa Kamu"
                                        android:textColor="@color/black"
                                        android:textSize="14sp" />
                                </LinearLayout>


                                <androidx.recyclerview.widget.RecyclerView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    tools:listitem="@layout/bahasa_section">
                                </androidx.recyclerview.widget.RecyclerView>
                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>


                </LinearLayout>


            </LinearLayout>
    </LinearLayout>
</LinearLayout>