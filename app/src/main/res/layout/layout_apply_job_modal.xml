<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:layout_width="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true"
    android:id="@+id/layout_apply_job_modal"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="70dp"
        android:id="@+id/btn_bottom_sheet"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_bottom_sheet_1"
        android:scaleType="centerCrop"
        android:layout_gravity="center|top"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/show_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/poppins_semibold"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:ignore="MissingConstraints">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:layout_marginTop="8dp"
                android:paddingBottom="16dp"
                android:text="@string/melamar"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="16dp"
                />
            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginBottom="10dp"
                android:background="@color/light_500" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/withdrawicon_salaman" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/title_melamar"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="36dp"
                android:layout_marginRight="36dp"
                android:fontFamily="@font/poppins"
                android:paddingTop="6dp"
                android:text="@string/subtitle_melamar"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="12dp" />
        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/confirmWithdraw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:backgroundTint="@color/danger_500"
        android:fontFamily="@font/poppins_bold"
        android:text="Konfirmasi"
        android:layout_marginHorizontal="16dp"
        android:textAllCaps="false"
        android:textSize="14dp"
        app:cornerRadius="100dp"
        tools:layout_editor_absoluteX="17dp"
        tools:layout_editor_absoluteY="346dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
