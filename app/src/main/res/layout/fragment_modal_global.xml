<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/light_500"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_modal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="600dp"
        android:background="@drawable/rounded"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <ImageView
            android:layout_width="80dp"
            android:id="@+id/btn_bottom_sheet"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_bottom_sheet_1"
            android:scaleType="centerCrop"
            android:layout_gravity="center|top"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/judul_bottom_sheet"
                android:layout_marginTop="40dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="Appeal"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="16sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/light_500" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Alasan Melakukan Appeal"
                    android:textColor="@color/dark_100"
                    android:textSize="14sp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:background="@color/light_300"
                        android:layout_height="wrap_content">
                <EditText
                    android:hint="Masukkan alasan melakukan appeal"
                    android:background="@null"
                    android:clickable="true"
                    android:paddingLeft="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="100dp"
                    android:fontFamily="@font/poppins"
                    android:textAlignment="textStart"
                    android:textColor="@color/dark_100"
                    android:textSize="12sp" />
                    </LinearLayout>
            </androidx.cardview.widget.CardView>
            </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="Masukkan Dokumen Pendukung"
                android:textColor="@color/dark_100"
                android:textSize="14sp"/>

            <com.google.android.material.button.MaterialButton
                android:layout_marginTop="10dp"
                android:id="@+id/btn_unggah_dokumen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="top"
                android:backgroundTint="@color/white"
                app:strokeColor="@color/danger_500"
                app:strokeWidth="1dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Unggah Dokumen"
                android:textColor="@color/danger_500"
                android:textAllCaps="false"
                android:textSize="14dp"
                app:cornerRadius="100dp"
                tools:layout_editor_absoluteX="17dp"
                tools:layout_editor_absoluteY="346dp"/>
        </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="10dp"
                android:background="@color/light_500"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="16dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_kirim_dokumen"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="top"
                    android:backgroundTint="@color/danger_500"
                    app:strokeColor="@color/danger_500"
                    app:strokeWidth="1dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Kirim"
                    android:textColor="@color/white"
                    android:textAllCaps="false"
                    android:textSize="14dp"
                    app:cornerRadius="100dp"
                    tools:layout_editor_absoluteX="17dp"
                    tools:layout_editor_absoluteY="346dp"/>
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
