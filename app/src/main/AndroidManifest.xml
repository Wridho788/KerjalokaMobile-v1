<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.ciptakerjaarunika.kerjaloka">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="false"
        android:icon="@drawable/kerjaloka_logo_small"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kerjaloka"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity
            android:name=".modal_edit_ekspektasi_gaji_layout"
            android:exported="false" />
        <activity
            android:name=".modal_edit_interest_layout"
            android:exported="false" />
        <activity
            android:name=".modal_edit_job_layout"
            android:exported="false" />
        <activity
            android:name=".item_profile_minat_page"
            android:exported="false" />
        <activity
            android:name=".item_profile_user_page"
            android:exported="false" />
        <activity
            android:name=".profile_page"
            android:exported="false" />
        <activity
            android:name=".activity_item_js_preference_minat"
            android:exported="false" />
        <activity
            android:name=".item_js_profile_user"
            android:exported="false" />
        <activity
            android:name=".js_profile"
            android:exported="false" />
        <activity
            android:name=".ui.search_job.SearchJob"
            android:exported="true" />
        <activity
            android:name=".ui.WelcomingPage.OnBoarding.OnBoarding"
            android:exported="true"
            android:theme="@style/Theme.Kerjaloka.NoActionBar" />
        <activity
            android:name=".ui.WelcomingPage.SplashScreen.SplashScreen"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>