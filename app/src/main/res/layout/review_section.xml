<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_send_review"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_marginHorizontal="16dp"
    android:weightSum="2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2"
        android:layout_marginEnd="5dp"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.8"
            android:backgroundTint="@color/danger_100"
            android:elevation="0dp"
            app:cardCornerRadius="30dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:paddingHorizontal="16dp"
                tools:ignore="RtlSymmetry">

                <RatingBar
                    android:id="@+id/rBar"
                    style="@android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:isIndicator="true"
                    android:max="5"
                    android:rating="3"
                    android:stepSize="0"
                    android:scaleX=".4"
                    android:scaleY=".4"
                    android:transformPivotX="10dp"
                    android:transformPivotY="10dp" />

                <TextView
                    android:id="@+id/ratingtext"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="15dp"
                    android:fontFamily="@font/poppins"
                    android:gravity="center_horizontal|center_vertical|center"
                    android:textColor="@color/trueGray_500"
                    android:textSize="12sp"
                    android:text="3 dari 5"
                    />
            </LinearLayout>


        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/totalReviewText"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_weight="0.20"
            android:fontFamily="@font/poppins"
            android:text="1 Reviews"
            android:gravity="center_horizontal|center_vertical|center"
            android:textColor="@color/trueGray_500"
            android:textSize="12sp" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/btn_send_review_jobseeker"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/button_secondary"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|center_vertical"
            android:fontFamily="@font/poppins"
            android:paddingVertical="10dp"
            android:text="@string/beri_review"
            android:textAlignment="center"
            android:textColor="@color/danger_500"
            android:textStyle="bold" />
    </LinearLayout>


</LinearLayout>
