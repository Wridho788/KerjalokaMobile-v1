<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    app:layout_constraintHeight_percent="80"
    android:layout_height="wrap_content">

        <ImageView
            android:layout_width="70dp"
            android:id="@+id/btn_bottom_sheet"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_bottom_sheet_1"
            android:scaleType="centerCrop"
            android:layout_gravity="center|top"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/show_sheet"
            android:layout_width="match_parent"
            android:layout_height="1000dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/poppins_semibold"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:text="Withdraw Job"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="16dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    tools:ignore="MissingConstraints">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="8dp"
                            android:paddingBottom="16dp"
                            android:text="Withdraw"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="16dp" />

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:src="@drawable/withdrawicon_salaman" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Yakin Ingin Melamar?"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="18dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="36dp"
                            android:layout_marginRight="36dp"
                            android:fontFamily="@font/poppins"
                            android:paddingTop="6dp"
                            android:text="Kamu akan melamar ke pekerjaan ini, apa kamu yakin untuk melamar pekerjaan ini?"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="12dp" />
                </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWithdraw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:backgroundTint="@color/danger_500"
            android:fontFamily="@font/poppins_bold"
            android:text="Confirm"
            android:layout_marginHorizontal="16dp"
            android:textAllCaps="false"
            android:textSize="14dp"
            app:cornerRadius="100dp"
            tools:layout_editor_absoluteX="17dp"
            tools:layout_editor_absoluteY="346dp" />


</androidx.coordinatorlayout.widget.CoordinatorLayout>
