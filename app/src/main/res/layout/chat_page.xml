<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/chat_page"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.InterviewPage.ChatPage"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/chatToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:logoScaleType="centerInside"
        app:titleMarginStart="20dp"
        android:elevation="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="2dp"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="22dp"
                android:layout_marginRight="10dp"
                android:layout_gravity="center"
                android:background="@drawable/back_primary_icon"
                android:layout_height="22dp"/>
            <androidx.cardview.widget.CardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="15dp"
                android:layout_gravity="center"
                app:cardElevation="0dp"
                app:cardCornerRadius="100dp"
                >
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/userPhoto"
                    android:src="@drawable/kerjaloka_logo_small"
                    android:scaleType="centerInside"
                    />
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight=".8"
                android:orientation="vertical">
                <androidx.percentlayout.widget.PercentRelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                <TextView
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"
                    app:layout_heightPercent="50%"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="User Full Name"
                    android:textSize="15dp"
                    android:id="@+id/title"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    />
                    <TextView
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:layout_height="match_parent"
                        android:layout_width="match_parent"
                        app:layout_heightPercent="50%"
                        android:layout_alignParentBottom="true"
                        android:fontFamily="@font/poppins"
                        android:text="Job Position"
                        android:textSize="14dp"
                        android:id="@+id/description"
                        android:ellipsize="end"
                        android:singleLine="true"
                        />
                </androidx.percentlayout.widget.PercentRelativeLayout>
            </LinearLayout>
<!--            <ImageButton-->
<!--                android:layout_width="22dp"-->
<!--                android:layout_marginRight="20dp"-->
<!--                android:layout_gravity="center"-->
<!--                android:id="@+id/voice_call_btn"-->
<!--                android:background="@drawable/phone_icon"-->
<!--                android:layout_height="22dp"/>-->
            <ImageButton
                android:layout_width="22dp"
                android:layout_gravity="center"
                android:id="@+id/video_call_btn"
                android:background="@drawable/video_call_icon"
                android:layout_marginRight="10dp"
                android:layout_height="22dp"/>
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="15dp"
        android:orientation="vertical"
        android:background="@color/white">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewChat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight=".8"
            tools:listitem="@layout/message_right1"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                android:layout_marginRight="10dp"

                app:cardElevation="0dp">
            <LinearLayout
                android:id="@+id/btn_emoji"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:background="@drawable/round_background"
                android:orientation="horizontal">

                <ImageButton
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:id="@+id/openCamera"
                    android:layout_marginHorizontal="15dp"
                    android:background="@drawable/camera_icon"
                    />
                <EditText
                    android:layout_width="0dp"
                    android:layout_weight="0.8"
                    android:textSize="15dp"
                    android:background="@null"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/txt_message"
                    android:hint="Ketik Pesan" />
            </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="40dp"
                android:layout_height="match_parent"
                app:cardCornerRadius="100dp"
                app:cardElevation="0dp"
                android:id="@+id/btn_send"
                android:layout_gravity="center">
            <ImageView
                android:layout_width="50dp"
                android:id="@+id/img_btnsend"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="15dp"
                android:src="@drawable/ic_attach_file"
                tools:ignore="ContentDescription"
                android:layout_gravity="center"
                android:background="#FAFAFA"
                android:rotation="45"
                android:padding="9dp"
                />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </LinearLayout>
    </LinearLayout>
</FrameLayout>