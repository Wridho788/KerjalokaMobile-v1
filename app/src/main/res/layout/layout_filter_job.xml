<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_filter_company"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_500"
    tools:context=".ui.Screens.JobSearch.FilterJobModal"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/title"
        android:layout_alignParentTop="true"
        android:background="@color/white">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/black"
            android:clickable="false"
            app:cardCornerRadius="100dp"
            app:cardElevation="0dp" />
        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/filter_sesuai_kebutuhan"
            android:textAlignment="center"
            android:textColor="@color/dark_100"
            android:textSize="16sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:id="@+id/filter_list"
        android:layout_below="@+id/title"
        android:background="@color/white"
        >
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="7dp"
            android:layout_marginHorizontal="16dp"
            android:scrollbars="none"
            tools:ignore="ScrollViewCount">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="10dp"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/lokasi"
                        style="@style/ShapeAppearanceOverlay.Material3.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/danger_100"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/lokasi"
                        android:textColor="@color/danger_500"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:chipCornerRadius="50dp"
                        app:chipStrokeColor="@color/danger_500"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/job_type"
                        style="@style/ShapeAppearanceOverlay.Material3.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/danger_100"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Jenis Pekerjaan"
                        android:textColor="@color/danger_500"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:chipCornerRadius="50dp"
                        app:chipStrokeColor="@color/danger_500"
                        app:chipStrokeWidth="1dp" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/skill"
                        style="@style/ShapeAppearanceOverlay.Material3.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/danger_100"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Skill"
                        android:textColor="@color/danger_500"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:chipCornerRadius="50dp"
                        app:chipStrokeColor="@color/danger_500"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/experience"
                        style="@style/ShapeAppearanceOverlay.Material3.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/danger_100"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Pengalaman"
                        android:textColor="@color/danger_500"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:chipCornerRadius="50dp"
                        app:chipStrokeColor="@color/danger_500"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/salary"
                        style="@style/ShapeAppearanceOverlay.Material3.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/danger_100"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Gaji"
                        android:textColor="@color/danger_500"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:chipCornerRadius="50dp"
                        app:chipStrokeColor="@color/danger_500"
                        app:chipStrokeWidth="1dp" />

                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_below="@+id/filter_list">
        <androidx.appcompat.widget.SearchView
            android:id="@+id/search_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="10dp"
            android:background="@drawable/search_background"
            android:focusable="true"
            android:fontFamily="@font/poppins_light"
            android:inputType="text"
            android:keepScreenOn="true"
            android:paddingEnd="10dp"
            android:queryHint="Cari Lokasi"
            android:searchIcon="@drawable/ic_search"
            android:textColor="@color/dark_100"
            android:textSize="12sp"
            android:tooltipText="@string/search_placeholder"
            app:iconifiedByDefault="false"
            app:queryHint="@string/search_placeholder"
            tools:ignore="RtlSymmetry"
            tools:targetApi="o" />
        <TextView
            android:id="@+id/btn_hapus_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hapus Semua"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="end"
            android:layout_marginEnd="16dp"
            android:textColor="@color/danger_500"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_filter"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            tools:listitem="@layout/item_filter"
            android:layout_marginVertical="16dp"
            />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/layout_konfirmasi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingBottom="25dp"
        android:paddingTop="10dp"
        android:layout_alignParentBottom="true">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_konfirmasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:backgroundTint="@color/danger_500"
            android:fontFamily="@font/poppins"
            android:text="@string/konfimasi"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:cornerRadius="100dp" />
    </LinearLayout>
</RelativeLayout>
