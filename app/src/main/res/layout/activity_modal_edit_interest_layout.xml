<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    app:layout_constraintHeight_percent="80"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="50dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="8dp"
        android:background="@color/black"
        android:backgroundTint="@color/black"
        android:layout_height="4dp"
        android:elevation="0dp"
        android:padding="16dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="10dp"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/show_sheet_job_type"
        android:layout_marginBottom="32dp"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:text="Withdraw Job"
        android:textSize="16dp"
        android:paddingTop="8dp"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="@color/black"
        android:textAlignment="center"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/minat_pelamar1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:ignore="MissingConstraints">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginRight="16dp"
                android:layout_marginLeft="16dp"
                android:text="Minat"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:paddingTop="0dp"
                android:text="Bidang Pekerjaan yang Diminati ?"
                android:textColor="@color/black"
                android:textSize="14dp"
                android:layout_marginRight="16dp"
                android:layout_marginLeft="16dp"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_marginTop="0dp"
                android:layout_marginRight="16dp"
                android:layout_marginLeft="16dp"
                android:paddingLeft="4dp"
                android:paddingTop="13dp"
                android:layout_height="wrap_content"
                android:id="@+id/plh_minat"
                android:height="40dp"
                android:inputType="text|textMultiLine"
                android:gravity="top"
                android:fontFamily="@font/poppins_semibold"
                android:lines="8"
                android:background="@color/light_300"
                android:maxLines="10"
                android:scrollbars="horizontal"
                android:hint="Pilih Minat"
                android:textSize="10dp"/>


            <com.google.android.material.button.MaterialButton
                android:layout_marginTop="16dp"
                android:id="@+id/btn_tbh_minat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="top"
                android:backgroundTint="@color/white"
                app:strokeColor="@color/danger_500"
                app:strokeWidth="1dp"
                android:layout_marginRight="16dp"
                android:layout_marginLeft="16dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Tambah Minat"
                android:textColor="@color/danger_500"
                android:textAllCaps="false"
                android:textSize="14dp"
                app:cornerRadius="100dp"
                tools:layout_editor_absoluteX="17dp"
                tools:layout_editor_absoluteY="346dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/minat_pelamar1"
            >

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroup_minat_pekerjaan_pelamar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:ignore="MissingConstraints"
                android:padding="16dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp">


                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    app:closeIconEnabled="true"
                    app:closeIconTint="@color/danger_500"
                    app:chipBackgroundColor="@color/danger_100"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="Audio / Video Technology"
                    android:clickable="true"
                    >
                </com.google.android.material.chip.Chip>

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/danger_100"
                    android:fontFamily="@font/poppins"
                    android:text="Science">
                </com.google.android.material.chip.Chip>

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/danger_100"
                    android:fontFamily="@font/poppins"
                    android:text="Art / Craft">
                </com.google.android.material.chip.Chip>

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/danger_100"
                    android:fontFamily="@font/poppins"
                    android:text="Communication">
                </com.google.android.material.chip.Chip>

            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWithdraw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:backgroundTint="@color/danger_500"
        android:fontFamily="@font/poppins_bold"
        android:text="Simpan"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:textAllCaps="false"
        android:textSize="14dp"
        app:cornerRadius="100dp"
        tools:layout_editor_absoluteX="17dp"
        tools:layout_editor_absoluteY="346dp"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
