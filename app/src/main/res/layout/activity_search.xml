<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.Screens.SearchScreen.SearchActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/search_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="10dp"
                android:background="@drawable/search_background"
                android:focusable="true"
                android:fontFamily="@font/poppins"
                android:inputType="text"
                android:keepScreenOn="true"
                android:paddingHorizontal="15dp"
                android:queryHint="@string/search_placeholder"
                android:searchIcon="@drawable/ic_search"
                android:textColor="@color/dark_100"
                android:textSize="12sp"
                android:tooltipText="@string/search_placeholder"
                app:queryHint="@string/search_placeholder"
                tools:targetApi="o" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/title_list_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/result_search"
                    android:textColor="@color/dark_100"
                    android:textSize="16sp"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/result_search_job"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_light"
                    android:text="a"
                    android:textColor="@color/dark_100"
                    android:textSize="10sp"
                    tools:ignore="SmallSp" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_latest_search_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="15dp"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/latest_search"
                        android:textColor="@color/dark_100"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/btn_remove_latest_search"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/delete_history"
                        android:textColor="@color/danger_500"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_latest_search"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginBottom="15dp"
                        android:background="@drawable/button_flat"
                        android:fontFamily="@font/poppins"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"
                        android:text="Engineer"
                        android:textAllCaps="false"
                        android:textColor="@color/dark_100"
                        android:textSize="12sp"
                        app:cornerRadius="100dp" />

                    <Button
                        android:id="@+id/btn_latest_search_1"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginBottom="15dp"
                        android:background="@drawable/button_flat"
                        android:fontFamily="@font/poppins"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"
                        android:text="Pertamina"
                        android:textAllCaps="false"
                        android:textColor="@color/dark_100"
                        android:textSize="12sp"
                        app:cornerRadius="100dp" />

                    <Button
                        android:id="@+id/btn_latest_search_2"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginBottom="15dp"
                        android:background="@drawable/button_flat"
                        android:fontFamily="@font/poppins"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"
                        android:text="UX Researcher"
                        android:textAllCaps="false"
                        android:textColor="@color/dark_100"
                        android:textSize="12sp"
                        app:cornerRadius="100dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_latest_search_3"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginBottom="15dp"
                        android:background="@drawable/button_flat"
                        android:fontFamily="@font/poppins"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"
                        android:text="PT. Cipta Kerja Indonesia"
                        android:textAllCaps="false"
                        android:textColor="@color/dark_100"
                        android:textSize="12sp"
                        app:cornerRadius="100dp" />

                    <Button
                        android:id="@+id/btn_latest_search_4"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginBottom="15dp"
                        android:background="@drawable/button_flat"
                        android:fontFamily="@font/poppins"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"
                        android:text="Accounting"
                        android:textAllCaps="false"
                        android:textColor="@color/dark_100"
                        android:textSize="12sp"
                        app:cornerRadius="100dp" />


                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginVertical="20dp"
                android:background="@color/light_500" />

            <LinearLayout
                android:id="@+id/layout_top_search_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="15dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/top_search"
                        android:textColor="@color/dark_100"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_top_search"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginBottom="15dp"
                        android:background="@drawable/button_flat"
                        android:fontFamily="@font/poppins"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"
                        android:text="UI UX Designer"
                        android:textAllCaps="false"
                        android:textColor="@color/dark_100"
                        android:textSize="12sp"
                        app:cornerRadius="100dp" />

                    <Button
                        android:id="@+id/btn_top_search_2"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginBottom="15dp"
                        android:background="@drawable/button_flat"
                        android:fontFamily="@font/poppins"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"
                        android:text="Project Manager"
                        android:textAllCaps="false"
                        android:textColor="@color/dark_100"
                        android:textSize="12sp"
                        app:cornerRadius="100dp" />

                    <Button
                        android:id="@+id/btn_top_search_3"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginBottom="15dp"
                        android:background="@drawable/button_flat"
                        android:fontFamily="@font/poppins"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"
                        android:text="Art Director"
                        android:textAllCaps="false"
                        android:textColor="@color/dark_100"
                        android:textSize="12sp"
                        app:cornerRadius="100dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_top_search_4"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginBottom="15dp"
                        android:background="@drawable/button_flat"
                        android:fontFamily="@font/poppins"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"
                        android:text="Gojek"
                        android:textAllCaps="false"
                        android:textColor="@color/dark_100"
                        android:textSize="12sp"
                        app:cornerRadius="100dp" />

                    <Button
                        android:id="@+id/btn_top_search_5"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginBottom="15dp"
                        android:background="@drawable/button_flat"
                        android:fontFamily="@font/poppins"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"
                        android:text="Traveloka"
                        android:textAllCaps="false"
                        android:textColor="@color/dark_100"
                        android:textSize="12sp"
                        app:cornerRadius="100dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>