<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingHorizontal="10dp"
    android:layout_height="50dp"
    android:layout_marginVertical="15dp"
    android:clickable="true"
    android:id="@+id/section_container"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/sectionName"
            android:text="PT. Cipta Kerja Arunika Nusantara"
            android:textSize="15dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins_semibold"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Interview : "
                android:textSize="12dp"
                android:fontFamily="@font/poppins"
                android:ellipsize="end"
                android:singleLine="true"
                android:textFontWeight="500"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12"
                android:textSize="12dp"
                android:fontFamily="@font/poppins_semibold"
                android:ellipsize="end"
                android:id="@+id/applicantCount"
                android:textColor="@color/danger_500"
                android:singleLine="true"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="orang"
                android:textSize="12dp"
                android:layout_marginLeft="2dp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/danger_500"
                android:ellipsize="end"
                android:singleLine="true"
                />
        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="right"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:id="@+id/lastMessageOn"
            android:layout_height="18dp"
            android:layout_marginBottom="5dp"
            android:text="2022/08/20"
            android:textSize="12dp"
            android:visibility="gone"
            android:fontFamily="@font/poppins"
            android:textAlignment="textEnd"/>
        <TextView
            android:id="@+id/not_read"
            android:layout_width="25dp"
            android:layout_height="20dp"
            android:paddingTop="2dp"
            android:fontFamily="@font/poppins"
            android:textColor="@color/white"
            android:gravity="center"
            android:textAlignment="center"
            android:textSize="10dp"
            android:textFontWeight="700"
            android:visibility="gone"
            android:ellipsize="end"
            android:singleLine="true"
            android:background="@drawable/text_rounded"
            android:text="15"/>

    </LinearLayout>
</LinearLayout>