<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:ignore="UselessParent">

        <com.google.android.material.card.MaterialCardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/compny_tes_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:checkable="true"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="10dp"
            app:strokeColor="@color/light_500"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:weightSum="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp">

                    <TextView
                        android:id="@+id/tes_pernah_ada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tes yang pernah ada"
                        android:fontFamily="@font/poppins_semibold"
                        android:textSize="14sp"
                        android:textColor="@color/dark_100"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tstpage_1"
                            android:layout_width="match_parent"
                            android:text="1. Amet minim mollit non deserunt ullamco est sit aliqua dolor do amet sint. Velit officia consequat duis enim v..."
                            android:layout_height="wrap_content"
                            android:textColor="@color/trueGray_300"
                            android:fontFamily="@font/poppins"
                            android:textSize="10dp"/>

                        <TextView
                            android:id="@+id/tstpage_2"
                            android:layout_width="match_parent"
                            android:text="2. Amet minim mollit non deserunt ullamco est sit aliqua dolor do amet sint. Velit officia consequat duis enim v..."
                            android:layout_height="wrap_content"
                            android:textColor="@color/trueGray_300"
                            android:fontFamily="@font/poppins"
                            android:textSize="10dp"/>

                        <TextView
                            android:id="@+id/tstpage_3"
                            android:layout_width="match_parent"
                            android:text="3. Amet minim mollit non deserunt ullamco est sit aliqua dolor do amet sint. Velit officia consequat duis enim v..."
                            android:layout_height="wrap_content"
                            android:textColor="@color/trueGray_300"
                            android:fontFamily="@font/poppins"
                            android:textSize="10dp"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


    </LinearLayout>

</LinearLayout>