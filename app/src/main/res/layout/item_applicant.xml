<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center|center_horizontal">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_applicant"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="10dp"
        android:elevation="0dp"
        app:cardCornerRadius="10dp"
        app:strokeColor="@color/light_500"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:clickable="false"
                    android:elevation="0dp"
                    app:cardCornerRadius="10dp">

                    <ImageView
                        android:id="@+id/logo_applicant"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:radius="10dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/kerjaloka_logo_small" />
                </com.google.android.material.card.MaterialCardView>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp"
                    >

                    <TextView
                        android:id="@+id/name_applicant"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="John Doe"
                        android:textColor="@color/dark_100"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/location_applicant"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="Palembang, Sumatera Selatan"
                        android:textColor="@color/dark_100"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/status_applicant_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Qualified"
                        android:textColor="@color/green_300"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>


    </com.google.android.material.card.MaterialCardView>
</LinearLayout>