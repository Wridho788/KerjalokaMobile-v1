<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="8dp"
    android:orientation="vertical"
    tools:context=".ui.ProfilePage.manage_lampiran">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="ScrollViewCount">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                tools:ignore="UselessParent">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_lampiran"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checkable="true"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="10dp"
                    app:strokeColor="@color/light_500"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/lampiran_pelamar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="Lampiran"
                                android:textColor="@color/black"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/edit_lampiran_pelamar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="Edit"
                                android:textColor="@color/danger_500"
                                android:textSize="14sp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:fontFamily="@font/poppins"
                                android:text="Lampirkan berkas-berkasmu supaya kamu lebih diperhatikan oleh perusahaan."
                                android:textColor="@color/black"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:id="@+id/set_berkas_1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp">

                                <androidx.cardview.widget.CardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:cardCornerRadius="10dp"
                                    app:cardElevation="0dp">

                                    <LinearLayout
                                        android:id="@+id/spinnerDoc"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center">

                                        <ProgressBar
                                            style="?android:attr/progressBarStyleLarge"
                                            android:layout_width="50dp"
                                            android:layout_height="50dp" />
                                    </LinearLayout>

                                    <androidx.recyclerview.widget.RecyclerView
                                        android:id="@+id/RecyclerAttachment"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:visibility="gone"
                                        tools:listitem="@layout/attachment_card" />
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                tools:ignore="UselessParent">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_video_resume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="10dp"
                    app:strokeColor="@color/light_500"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/video_resume_pelamar"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="Video Resume"
                                android:textColor="@color/black"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginBottom="14dp"
                                android:fontFamily="@font/poppins"
                                android:text="Unggah video resume kamu, video resume berguna untuk mempermudah mengevaluasi kompetensi dan bakat pelamar yang memiliki relevansi dengan apa yang benar-benar dibutuhkan oleh perusahaan."
                                android:textColor="@color/black"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:id="@+id/spinnerResume"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginVertical="10dp"
                                android:gravity="center">

                                <ProgressBar
                                    style="?android:attr/progressBarStyleLarge"
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:layout_centerHorizontal="true" />
                            </LinearLayout>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/upload_video_resume_btn"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                app:cardCornerRadius="20dp"
                                app:strokeColor="@color/danger_500"
                                app:strokeWidth="2dp">

                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="15dp"
                                    android:paddingVertical="8dp">

                                    <TextView
                                        android:id="@+id/videoResumeName"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerInParent="true"
                                        android:fontFamily="@font/poppins_semibold"
                                        android:text="Upload Video Resume"
                                        android:textColor="@color/danger_500"
                                        android:textSize="14sp" />

                                    <ImageView
                                        android:id="@+id/btn_remove_resume"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentEnd="true"
                                        android:layout_centerVertical="true"
                                        android:src="@drawable/ic_close"
                                        android:visibility="gone"
                                        app:tint="@color/danger_500" />
                                </RelativeLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!--                    <com.google.android.material.button.MaterialButton-->
                            <!--                        android:id="@+id/btn_tbh_video_resume"-->
                            <!--                        android:layout_width="match_parent"-->
                            <!--                        android:layout_height="match_parent"-->
                            <!--                        android:layout_gravity="top"-->
                            <!--                        android:layout_marginLeft="8dp"-->
                            <!--                        android:layout_marginTop="16dp"-->
                            <!--                        android:layout_marginRight="8dp"-->
                            <!--                        android:backgroundTint="@color/white"-->
                            <!--                        android:fontFamily="@font/poppins_semibold"-->
                            <!--                        android:text="Upload Video Resume"-->
                            <!--                        android:textAllCaps="false"-->
                            <!--                        android:textColor="@color/danger_500"-->
                            <!--                        android:textSize="14dp"-->
                            <!--                        app:cornerRadius="100dp"-->
                            <!--                        app:strokeColor="@color/danger_500"-->
                            <!--                        app:strokeWidth="1dp"-->
                            <!--                        tools:layout_editor_absoluteX="17dp"-->
                            <!--                        tools:layout_editor_absoluteY="346dp"/>-->
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                tools:ignore="UselessParent">

                <com.google.android.material.card.MaterialCardView xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:id="@+id/card_status_vaksin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="10dp"
                    app:strokeColor="@color/light_500"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/status_vaksin_pelamar"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="Status Vaksin"
                                android:textColor="@color/black"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/edit_status_vaksin_pelamar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="Edit"
                                android:textColor="@color/danger_500"
                                android:textSize="14sp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:fontFamily="@font/poppins"
                                android:text="Unggah sertifikat tanda bukti vaksin kamu agar perusahaan dapat dengan tenang menawarkan lowongan kepada kamu."
                                android:textColor="@color/black"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:id="@+id/spinnerVac"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginVertical="10dp"
                                android:gravity="center">

                                <ProgressBar
                                    style="?android:attr/progressBarStyleLarge"
                                    android:layout_width="50dp"
                                    android:layout_height="50dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/vaccine_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp">

                                    <androidx.cardview.widget.CardView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/card_background"
                                        app:cardCornerRadius="10dp"
                                        app:cardElevation="0dp">

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:background="@drawable/card_background"
                                            android:orientation="horizontal">

                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight=".8"
                                                android:height="40dp"
                                                android:fontFamily="@font/poppins"
                                                android:paddingLeft="8dp"
                                                android:paddingTop="12dp"
                                                android:paddingBottom="10dp"
                                                android:text="Vaksin Pertama"
                                                android:textColor="@color/black"
                                                android:textSize="12sp" />

                                            <ImageView
                                                android:id="@+id/vaccine1Status"
                                                android:layout_width="24dp"
                                                android:layout_height="24dp"
                                                android:layout_gravity="center"
                                                android:layout_marginEnd="15dp"
                                                android:src="@drawable/ic_vaccine_reject" />
                                        </LinearLayout>
                                    </androidx.cardview.widget.CardView>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp">

                                    <androidx.cardview.widget.CardView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/card_background"
                                        app:cardCornerRadius="10dp"
                                        app:cardElevation="0dp">

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:background="@drawable/card_background"
                                            android:orientation="horizontal">

                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight=".8"
                                                android:height="40dp"
                                                android:fontFamily="@font/poppins"
                                                android:paddingLeft="8dp"
                                                android:paddingTop="12dp"
                                                android:paddingBottom="10dp"
                                                android:text="Vaksin Kedua"
                                                android:textColor="@color/black"
                                                android:textSize="12sp" />

                                            <ImageView
                                                android:id="@+id/vaccine2Status"
                                                android:layout_width="24dp"
                                                android:layout_height="24dp"
                                                android:layout_alignParentRight="true"
                                                android:layout_gravity="center"
                                                android:layout_marginRight="15dp"
                                                android:src="@drawable/ic_vaccine_reject"
                                                tools:ignore="ContentDescription" />
                                        </LinearLayout>
                                    </androidx.cardview.widget.CardView>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp">

                                    <androidx.cardview.widget.CardView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/card_background"
                                        app:cardCornerRadius="10dp"
                                        app:cardElevation="0dp">

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:background="@drawable/card_background"
                                            android:orientation="horizontal">

                                            <TextView
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight=".8"
                                                android:height="40dp"
                                                android:fontFamily="@font/poppins"
                                                android:paddingStart="8dp"
                                                android:paddingTop="12dp"
                                                android:paddingBottom="10dp"
                                                android:text="Vaksin Ketiga"
                                                android:textColor="@color/black"
                                                android:textSize="12sp" />

                                            <ImageView
                                                android:id="@+id/vaccine3Status"
                                                android:layout_width="24dp"
                                                android:layout_height="24dp"
                                                android:layout_alignParentRight="true"
                                                android:layout_gravity="center"
                                                android:layout_marginEnd="15dp"
                                                android:src="@drawable/ic_vaccine_reject"
                                                tools:ignore="ContentDescription" />
                                        </LinearLayout>
                                    </androidx.cardview.widget.CardView>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
