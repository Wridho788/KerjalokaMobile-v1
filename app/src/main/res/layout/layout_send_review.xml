                                android:text="Pengembangan Karir"
                                android:textColor="@color/black"
                                app:chipStrokeColor="@color/stroke_chip"
                                app:chipStrokeWidth="2dp" />
                        </com.google.android.material.chip.ChipGroup>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="5dp"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Review"
                            android:textColor="@color/black"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/txt_review"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/light_300"
                            android:fontFamily="@font/poppins"
                            android:gravity="top|start"
                            android:hint="Masukkan komentar rating"
                            android:lines="6"
                            android:padding="14dp"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="0dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/light_500" />

                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:background="@color/white"
                android:paddingHorizontal="15dp"
                android:paddingBottom="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sendReview"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/danger_500"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Beri Review"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    app:cornerRadius="100dp" />
            </LinearLayout>
        </RelativeLayout>
