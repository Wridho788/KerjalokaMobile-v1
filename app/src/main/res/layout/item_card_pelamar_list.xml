<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/light_300"
    android:layout_marginTop="10dp"
    app:cardCornerRadius="10dp"
    app:strokeColor="@color/trueGray_100"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/name_applicant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="John Doe"
            android:textColor="@color/dark_100"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/location_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:text="Kota Medan, Sumatera Utara"
            android:textColor="@color/trueGray_50"
            android:textSize="10sp"
            tools:ignore="SmallSp" />

        <TextView
            android:id="@+id/positionJob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins"
            android:text="Software Enterprise"
            android:textColor="@color/dark_100"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/locationJob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_light"
            android:text="Microsoft"
            android:textColor="@color/dark_100"
            android:textSize="10sp"
            tools:ignore="SmallSp" />

        <TextView
            android:id="@+id/txt_pendidikan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins"
            android:text="Software Enterprise"
            android:textColor="@color/dark_100"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/instansi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_light"
            android:text="Princeton University"
            android:textColor="@color/dark_100"
            android:textSize="10sp"
            tools:ignore="SmallSp" />


    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
