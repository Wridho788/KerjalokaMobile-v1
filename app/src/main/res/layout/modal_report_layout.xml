<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    app:layout_constraintHeight_percent="80"
    android:layout_height="match_parent">


    <androidx.cardview.widget.CardView
        android:layout_width="50dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="8dp"
        android:background="@color/gray_600"
        android:backgroundTint="@color/gray_600"
        android:layout_height="4dp"
        android:elevation="0dp"
        android:padding="16dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="10dp"
        />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/show_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="Withdraw Job"
        android:textSize="16dp"
        android:paddingTop="8dp"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="@color/black"
        android:textAlignment="center"
        android:layout_marginTop="10dp"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:ignore="MissingConstraints">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Laporkan Lowongan Ini :"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp"
                    android:textSize="14dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/black"/>

                <EditText
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:padding="8dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/reportMessage"
                    android:inputType="text|textMultiLine"
                    android:gravity="top"
                    android:lines="20"
                    android:background="@color/light_300"
                    android:maxLines="20"
                    android:scrollbars="vertical"
                    android:hint="Masukkan alasan melakukan report"
                    android:textSize="14dp"
                    />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/reportJobBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:layout_gravity="bottom"
        android:backgroundTint="@color/danger_500"
        android:fontFamily="@font/poppins_bold"
        android:text="Confirm"
        android:textAllCaps="false"
        android:textSize="14dp"
        app:cornerRadius="100dp"
        tools:layout_editor_absoluteX="17dp"
        tools:layout_editor_absoluteY="346dp" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
