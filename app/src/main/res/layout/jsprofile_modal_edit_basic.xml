<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_apply_job_modal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">



    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Edit Informasi Dasar"
        android:textAlignment="center"
        android:textColor="@color/dark_100"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginVertical="16dp"
        android:background="@color/light_500" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center_horizontal"
            android:elevation="0dp"
            android:padding="8dp"
            android:src="@drawable/profile"
            app:shapeAppearanceOverlay="@style/Circular"
            app:strokeColor="@color/light_500"
            app:strokeWidth="1dp"></com.google.android.material.imageview.ShapeableImageView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/poppins_semibold"
            android:text="Perbarui Foto"
            android:textColor="@color/danger_500"
            android:textSize="16dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingRight="16dp"
        android:paddingLeft="16dp"
        android:paddingTop="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:fontFamily="@font/poppins"
            android:text="Nama Lengkap"
            android:textColor="@color/dark_100"
            android:textSize="14sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7sp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:cardCornerRadius="@dimen/edittext_radius"
            app:cardElevation="0dp">

            <EditText
                android:id="@+id/jsName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/light_300"
                android:fontFamily="@font/poppins"
                android:hint="Jhon Doe"
                android:padding="14dp"
                android:textColor="@color/black"
                android:textSize="12sp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingRight="16dp"
        android:paddingLeft="16dp"
        android:paddingTop="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:text="Nomor KTP (Kartu Tanda Penduduk)"
            android:textColor="@color/dark_100"
            android:textSize="14sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7sp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:cardCornerRadius="@dimen/edittext_radius"
            app:cardElevation="0dp">

            <EditText
                android:id="@+id/jsKTP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/light_300"
                android:fontFamily="@font/poppins"
                android:hint="1234567887654321"
                android:padding="14dp"
                android:inputType="number"
                android:textColor="@color/black"
                android:textSize="12sp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingRight="16dp"
        android:paddingLeft="16dp"
        android:paddingTop="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:text="Jenis Kelamin"
            android:textColor="@color/dark_100"
            android:textSize="14sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7sp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:cardCornerRadius="@dimen/edittext_radius"
            app:cardElevation="0dp">

            <EditText
                android:id="@+id/jsGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/light_300"
                android:fontFamily="@font/poppins"
                android:hint="1234567887654321"
                android:padding="14dp"
                android:inputType="number"
                android:textColor="@color/black"
                android:textSize="12sp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingRight="16dp"
        android:paddingLeft="16dp"
        android:paddingTop="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:text="Alamat"
            android:textColor="@color/dark_100"
            android:textSize="14sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7sp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:cardCornerRadius="@dimen/edittext_radius"
            app:cardElevation="0dp">

            <EditText
                android:id="@+id/jsAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/light_300"
                android:fontFamily="@font/poppins"
                android:hint="Jl. Berdua"
                android:padding="14dp"
                android:inputType="number"
                android:textColor="@color/black"
                android:textSize="12sp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginBottom="20dp"
        android:background="@color/light_500" />

    <com.google.android.material.button.MaterialButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:backgroundTint="@color/danger_500"
        android:fontFamily="@font/poppins"
        android:text="@string/konfimasi"
        android:textAllCaps="false"
        android:textSize="14sp"
        app:cornerRadius="100dp" />
</LinearLayout>