<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/show_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Withdraw Job"
            android:textSize="16dp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/black"
            android:textAlignment="center"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Withdraw"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="16dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:paddingTop="6dp"
                    android:paddingBottom="16dp"/>


                <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yakin Ingin Melamar?"
            android:textAlignment="center"
            android:layout_marginTop="54dp"
            android:textColor="@color/black"
            android:textSize="18dp"
            android:fontFamily="@font/poppins_semibold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12dp"
            android:fontFamily="@font/poppins"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:text="Kamu akan melamar ke pekerjaan ini, apa kamu yakin untuk melamar pekerjaan ini?"
            android:paddingTop="6dp"
            />

                <com.google.android.material.button.MaterialButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnWithdraw"
                    android:text="Tarik Lamaran"
                    android:textColor="@color/danger_500"
                    android:textAllCaps="false"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="14dp"
                    app:cornerRadius="100dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_horizontal"
                    />

        </LinearLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>
