<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/chat_page"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.InterviewPage.Jobseeker.ChatPage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/chatToolbar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/white"
            android:elevation="10dp"
            app:logoScaleType="centerInside"
            app:titleMarginStart="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="2dp">

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/back_primary_icon" />

                <androidx.cardview.widget.CardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:layout_marginRight="15dp"
                    app:cardCornerRadius="100dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/userPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        android:src="@drawable/kerjaloka_logo_small" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_weight=".8"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:text="Reyhan"
                    android:textColor="@color/black"
                    android:textSize="15dp" />

                <ImageButton
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:layout_marginRight="20dp"
                    android:background="@drawable/phone_icon" />

                <ImageButton
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/video_call_icon" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="15dp"
        android:orientation="vertical"
        android:background="@color/white">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewChat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight=".8"
            tools:listitem="@layout/message_right1"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                android:layout_marginRight="10dp"

                app:cardElevation="0dp">
            <LinearLayout
                android:id="@+id/btn_emoji"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:background="@drawable/round_background"
                android:orientation="horizontal">

                <ImageButton
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:id="@+id/openCamera"
                    android:layout_marginHorizontal="15dp"
                    android:background="@drawable/camera_icon"
                    />
                <EditText
                    android:layout_width="0dp"
                    android:layout_weight="0.8"
                    android:textSize="15dp"
                    android:background="@null"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/txt_message"
                    android:hint="Ketik Pesan" />
            </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="40dp"
                android:layout_height="match_parent"
                app:cardCornerRadius="100dp"
                app:cardElevation="0dp"
                android:id="@+id/btn_send"
                android:layout_gravity="center">
            <ImageView
                android:layout_width="50dp"
                android:id="@+id/img_btnsend"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="15dp"
                android:src="@drawable/ic_attach_file"
                tools:ignore="ContentDescription"
                android:layout_gravity="center"
                android:background="#FAFAFA"
                android:rotation="45"
                android:padding="9dp"
                />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </LinearLayout>


    </LinearLayout>


</FrameLayout>