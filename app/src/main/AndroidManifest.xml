<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.ciptakerjaarunika.kerjaloka">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_DOWNLOAD_MANAGER" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="true"
        android:fullBackupContent="@xml/backup_rules"
        android:installLocation="preferExternal"
        android:hardwareAccelerated="true"
        android:icon="@drawable/kerjaloka_logo_small"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@drawable/kerjaloka_logo_small"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kerjaloka"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/kerjaloka_logo_small" />
        <!-- Set color used with incoming notification messages. This is used when no color is set for the incoming
             notification message. See README(https://goo.gl/6BKBk7) for more. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/danger_500" />

        <activity
            android:name=".Company.Companyjobdetail.AddJobActivity"
            android:exported="false"
            android:label="@string/title_activity_add_job"
            android:theme="@style/Theme.Kerjaloka.NoActionBar" />
        <activity
            android:name=".ui.Screens.CompanySearch.CompanySearchActivity"
            android:exported="true" />
<!--        <activity-->
<!--            android:name=".ui.ProfilePage.Preference.modal_edit_ekspektasi_gaji_layout"-->
<!--            android:exported="false"-->
<!--            tools:ignore="Instantiatable,MissingClass" />-->
        <activity
            android:name=".ui.NotificationPage.Notification"
            android:exported="true" />
        <activity
            android:name=".ui.NotificationPage.CompanyNotification"
            android:exported="true" />
        <activity
            android:name=".ui.Screens.SearchScreen.SearchActivity"
            android:exported="true" />
        <activity android:name=".ui.Screens.JobSearch.SearchJob" android:exported="true"
            tools:ignore="Instantiatable" />
        <!--        <activity-->
        <!--            android:name=".ui.ProfilePage.modal_edit_interest_layout"-->
        <!--            android:exported="false" />-->
        <!--        <activity-->
        <!--            android:name=".ui.MyTestList.TestList"
                    android:exported="true">
                </activity>

                <activity
                    android:name=".ui.ProfilePage.profile_page"-->
        <!--            android:exported="true" />-->
        <activity
            android:name=".ui.WelcomingPage.OnBoarding.OnBoarding"
            android:exported="true"
            android:theme="@style/Theme.Kerjaloka.NoActionBar" />
        <activity
            android:name=".ui.WelcomingPage.SplashScreen.SplashScreen"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.InterviewPage.IncomingCallActivity"
            android:exported="true"
            tools:ignore="Instantiatable" />

        <activity
            android:name=".MainActivity"
            android:exported="true" />


        
        <service android:name=".service.KerjalokaMessagingService"
            android:exported="false"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>
    </application>

</manifest>