<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    app:layout_constraintHeight_percent="80"

    android:layout_height="wrap_content">


        <androidx.cardview.widget.CardView
            android:layout_width="50dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="8dp"
            android:background="@color/gray_600"
            android:backgroundTint="@color/gray_600"
            android:layout_height="4dp"
            android:elevation="0dp"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="10dp"
            />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/show_sheet"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:text="Withdraw Job"
            android:textSize="16dp"
            android:paddingTop="8dp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/black"
            android:textAlignment="center"
            android:layout_marginTop="10dp"
            android:orientation="vertical">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    tools:ignore="MissingConstraints">



                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:paddingTop="6dp"
                            android:paddingBottom="16dp"
                            android:text="Withdraw"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="16dp" />

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:src="@drawable/withdrawicon_salaman"
                            />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="54dp"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Yakin Ingin Melamar?"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="18dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:paddingTop="6dp"
                            android:text="Kamu akan melamar ke pekerjaan ini, apa kamu yakin untuk melamar pekerjaan ini?"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="12dp"
                            android:layout_marginRight="36dp"
                            android:layout_marginLeft="36dp"/>
                </LinearLayout>



        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWithdraw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:backgroundTint="@color/danger_500"
            android:fontFamily="@font/poppins_bold"
            android:text="Confirm"
            android:textAllCaps="false"
            android:textSize="14dp"
            app:cornerRadius="100dp"
            tools:layout_editor_absoluteX="17dp"
            tools:layout_editor_absoluteY="346dp" />


</androidx.coordinatorlayout.widget.CoordinatorLayout>
