<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".Company.Companyjobdetail.ManageJobPage.fragment_company_add_jobs_2">

        <!-- Informasi Tambahan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Informasi Tambahan"
                android:textColor="@color/dark_100"
                android:textSize="16sp" />
        </LinearLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="50"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingTop="10dp"
                android:paddingRight="16dp">

                <TextView
                    android:id="@+id/compny_skill_dibutuhkan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="Skill Dibutuhkan"
                    android:textColor="@color/dark_100"
                    android:textSize="14dp" />
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/selectSkill_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:backgroundTint="@color/light_300"
                    app:cardCornerRadius="40dp"
                    app:strokeColor="@color/gray_400"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="20dp"
                        android:background="@color/light_300">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:paddingVertical="10dp"
                            android:hint="Pilih Skill"
                            android:textColor="@color/black"
                            android:textSize="12sp" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerVertical="true"
                            android:layout_alignParentRight="true"
                            android:src="@drawable/ic_chevron_down" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycle_skill"
                    android:layout_width="match_parent"
                    app:layout_constraintHeight_max="200dp"
                    app:layout_constrainedHeight="true"
                    android:layout_height="wrap_content"
                    tools:listitem="@layout/manage_job_selected_list"/>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="50"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingTop="10dp"
                android:paddingRight="16dp">

                <TextView
                    android:id="@+id/compny_kualifikasi_pend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="Kualifikasi Pendidikan (Optional)"
                    android:textColor="@color/dark_100"
                    android:textSize="14dp" />
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/selectTitle_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:backgroundTint="@color/light_300"
                    app:cardCornerRadius="40dp"
                    app:strokeColor="@color/gray_400"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="20dp"
                        android:background="@color/light_300">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:paddingVertical="10dp"
                            android:hint="Pilih Kualifikasi Pendidikan"
                            android:textColor="@color/black"
                            android:textSize="12sp" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerVertical="true"
                            android:layout_alignParentRight="true"
                            android:src="@drawable/ic_chevron_down" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycle_education"
                    android:layout_width="match_parent"
                    app:layout_constraintHeight_max="200dp"
                    app:layout_constrainedHeight="true"
                    android:layout_height="wrap_content"
                    tools:listitem="@layout/manage_job_selected_list"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="50"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingTop="10dp"
                android:paddingRight="16dp">

                <TextView
                    android:id="@+id/compny_tingkat_peng"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="Tingkat Pengalaman (Optional)"
                    android:textColor="@color/dark_100"
                    android:textSize="14dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/selectExperienceLevel_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:backgroundTint="@color/light_300"
                    app:cardCornerRadius="40dp"
                    app:strokeColor="@color/gray_400"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="20dp"
                        android:background="@color/light_300">
                        <TextView
                            android:id="@+id/experienceLevel_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:paddingVertical="10dp"
                            android:hint="Pilih Tingkat Pengalaman"
                            android:textColor="@color/black"
                            android:textSize="12sp" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerVertical="true"
                            android:layout_alignParentRight="true"
                            android:src="@drawable/ic_chevron_down" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="50"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingTop="10dp"
                android:paddingRight="16dp">

                <TextView
                    android:id="@+id/compny_bidang_pekerjaan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="Bidang Pekerjaan (Optional)"
                    android:textColor="@color/dark_100"
                    android:textSize="14dp" />
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/selectField_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:backgroundTint="@color/light_300"
                    app:cardCornerRadius="40dp"
                    app:strokeColor="@color/gray_400"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="20dp"
                        android:background="@color/light_300">
                        <TextView
                            android:id="@id/field_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:paddingVertical="10dp"
                            android:hint="Pilih Bidang Pekerjaan"
                            android:textColor="@color/black"
                            android:textSize="12sp" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerVertical="true"
                            android:layout_alignParentRight="true"
                            android:src="@drawable/ic_chevron_down" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="50"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingTop="10dp"
                android:paddingRight="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="Posisi Pekerjaan (Optional)"
                    android:textColor="@color/dark_100"
                    android:textSize="14dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/selectRole_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:backgroundTint="@color/light_300"
                    app:cardCornerRadius="40dp"
                    app:strokeColor="@color/gray_400"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="20dp"
                        android:background="@color/light_300">
                        <TextView
                            android:id="@+id/role_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:paddingVertical="10dp"
                            android:hint="Pilih Posisi Pekerjaan"
                            android:textColor="@color/black"
                            android:textSize="12sp" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerVertical="true"
                            android:layout_alignParentRight="true"
                            android:src="@drawable/ic_chevron_down" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="50"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingTop="10dp"
                android:paddingRight="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="Minimal Pengalaman (Optional)"
                    android:textColor="@color/dark_100"
                    android:textSize="14dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6.59dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    android:backgroundTint="@color/light_300"
                    app:cardCornerRadius="40dp"
                    app:strokeColor="@color/gray_400"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/light_300"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/compny_min_experience"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:fontFamily="@font/poppins"
                            android:hint="Masukkan Minimal Pengalaman (Optional)"
                            android:inputType="number"
                            android:padding="14dp"
                            android:textSize="12sp"
                            android:maxLength="2"
                            tools:ignore="Autofill,SmallSp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
        </ScrollView>
</LinearLayout>