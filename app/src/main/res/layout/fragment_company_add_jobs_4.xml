<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    tools:context=".Company.Companyjobdetail.fragment_company_add_jobs_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical">

        <!-- Toolbar -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="10dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                style="@style/Widget.MaterialComponents.Toolbar.Primary"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/danger_500">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center">

                    <LinearLayout
                        android:id="@+id/back_button"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:src="@drawable/ic_button_back_icon_thick_pink" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/toolbarTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_toEndOf="@id/back_button"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:paddingTop="3dp"
                        android:text="Tambah Pekerjaan"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_posting_pekerjaan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="10dp"
                        android:backgroundTint="@color/white"
                        android:fontFamily="@font/poppins"
                        android:gravity="center"
                        android:text="Posting"
                        android:textAllCaps="false"
                        android:textColor="@color/danger_500"
                        android:textSize="12sp"
                        app:cornerRadius="100sp"
                        tools:ignore="MissingConstraints" />
                </RelativeLayout>
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Section tes  -->
        <LinearLayout
            android:id="@+id/compny_rearrange_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="1">

                <TextView
                    android:id="@+id/compny_tes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Tes"
                    android:textColor="@color/dark_100"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/btn_compny_tes_rearrange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Rearrange"
                    android:textColor="@color/danger_500"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_alignParentBottom="true"
            android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycleRec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:listitem="@layout/section_company_add_jobs_4">
        </androidx.recyclerview.widget.RecyclerView>

        <androidx.percentlayout.widget.PercentRelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="10dp"
            android:layout_marginHorizontal="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_kembali_cmpny"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/white"
                android:fontFamily="@font/poppins"
                android:text="Kembali"
                android:textAllCaps="false"
                android:textColor="@color/danger_500"
                android:textSize="14dp"
                app:cornerRadius="100dp"
                app:layout_widthPercent="45%"
                app:strokeColor="@color/danger_500"
                app:strokeWidth="1dp"
                tools:layout_editor_absoluteX="17dp"
                tools:layout_editor_absoluteY="346dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_selanjutnya_cmpny"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/white"
                android:fontFamily="@font/poppins"
                android:text="Selanjutnya"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textColor="@color/danger_500"
                android:textSize="14dp"
                app:cornerRadius="100dp"
                app:iconTint="@color/danger_500"
                app:layout_widthPercent="45%"
                app:strokeColor="@color/danger_500"
                app:strokeWidth="1dp"
                tools:layout_editor_absoluteX="17dp"
                tools:layout_editor_absoluteY="346dp" />
        </androidx.percentlayout.widget.PercentRelativeLayout>
    </LinearLayout>
</ScrollView>
    </LinearLayout>

    <!-- Button -->



</RelativeLayout>