<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="3dp"
    android:elevation="3dp"
    >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="10dp"
            android:gravity="center"
            android:id="@+id/cardNotif"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            >
            <ImageView
                android:id="@+id/icNotif"
                android:layout_width="45dp"
                android:layout_height="45dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_toRightOf="@id/icNotif"
                android:layout_marginLeft="15sp">
                <TextView
                    android:id="@+id/notifTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:text="Notification"
                    />
                <TextView
                    android:id="@+id/notifDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:textSize="10sp"
                    android:text="bla bla blaa..."
                    />
                <TextView
                    android:id="@+id/notifTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:textSize="10sp"
                    android:textColor="@color/trueGray_300"
                    android:text="1 Hari lalu"
                    />
            </LinearLayout>
        </RelativeLayout>




</androidx.cardview.widget.CardView>