<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    app:layout_constraintHeight_percent="80"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="50dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="8dp"
        android:background="@color/black"
        android:backgroundTint="@color/black"
        android:layout_height="4dp"
        android:elevation="0dp"
        android:padding="16dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="10dp"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/show_sheet_salary_expectation"
        android:layout_marginBottom="32dp"
        android:layout_width="match_parent"
        android:layout_height="1000dp"
        android:text="Withdraw Job"
        android:textSize="16dp"
        android:paddingTop="8dp"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="@color/black"
        android:textAlignment="center"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/salary1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:ignore="MissingConstraints">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginRight="16dp"
                android:layout_marginLeft="16dp"
                android:text="Ekspektasi Gaji"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:paddingTop="0dp"
                android:text="Berapa ekspektasi gaji yang kamu inginkan ?"
                android:textColor="@color/black"
                android:textSize="14dp"
                android:layout_marginRight="16dp"
                android:layout_marginLeft="16dp"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_marginTop="0dp"
                android:layout_marginRight="16dp"
                android:layout_marginLeft="16dp"
                android:paddingLeft="4dp"
                android:paddingTop="13dp"
                android:layout_height="wrap_content"
                android:id="@+id/plh_minat"
                android:height="40dp"
                android:inputType="text|textMultiLine"
                android:gravity="top"
                android:fontFamily="@font/poppins"
                android:lines="8"
                android:background="@color/light_300"
                android:maxLines="10"
                android:scrollbars="horizontal"
                android:hint="Masukkan ekspektasi gaji"
                android:textSize="10dp"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_simpan_salary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:backgroundTint="@color/danger_500"
        android:fontFamily="@font/poppins_bold"
        android:text="Simpan"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:textAllCaps="false"
        android:textSize="14dp"
        app:cornerRadius="100dp"
        tools:layout_editor_absoluteX="17dp"
        tools:layout_editor_absoluteY="346dp"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
