<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10px"
    android:orientation="horizontal"
    android:background="@drawable/card_background"
    >

    <ImageView
        android:id="@+id/img_item_comic"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:scaleType="centerCrop"

        android:src="@drawable/jobdefault"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="16dp"
        android:layout_toEndOf="@id/img_item_comic"
        android:orientation="horizontal"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            >

            <TextView
                android:id="@+id/card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Job Position"
                android:textSize="22dp"
                android:fontFamily="@font/poppins_bold"/>
            <TextView
                android:id="@+id/card_companyname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Job Position"
                android:textSize="16dp"
                android:fontFamily="@font/poppins_semibold"/>
            <TextView
                android:id="@+id/card_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Job Position"
                android:textSize="16dp"
                android:fontFamily="@font/poppins"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="5dp"
                >
            <TextView
                android:id="@+id/card_testText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Test Dikerjakan :"
                android:textSize="16dp"
                android:fontFamily="@font/poppins"/>
                <TextView
                    android:id="@+id/card_testHasTake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="16dp"
                    android:fontFamily="@font/poppins"/>
                <TextView
                    android:id="@+id/card_slash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="/"
                    android:textSize="16dp"
                    android:fontFamily="@font/poppins"/>
                <TextView
                    android:id="@+id/card_totalTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="16dp"
                    android:fontFamily="@font/poppins"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>