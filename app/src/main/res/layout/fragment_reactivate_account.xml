<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".viewmodel.ReactiveAccount.ReactivateAccount"
    android:gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="77dp">

        <ImageView
            android:layout_width="328dp"
            android:layout_height="234dp"
            android:src="@drawable/nonaktif_akun" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="Akun Kamu Nonaktif"
            android:textColor="@color/black"
            android:textSize="22dp"
            android:textAlignment="center"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:textSize="12dp"
            android:text="Sepertinya akun kerjaloka kamu dalam mode non-aktif, untuk mengakses kembali akun ini kamu harus mengaktifkan akun kembali
Apakah kamu ingin mengaktifkan akun?"
            android:textColor="@color/black"
            android:textAlignment="center"
            android:layout_marginLeft="34dp"
            android:layout_marginRight="34dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingRight="16dp"
        android:paddingLeft="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:textSize="10dp"
                android:textColor="@color/trueGray_50"
                android:text="Tidak mengetahui mengenai hal ini? "/>
            <TextView
                android:id="@+id/halo_kerjaloka"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:textSize="10dp"
                android:textColor="@color/danger_500"
                android:text="Hubungi Kerjaloka"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:textSize="10dp"
                android:textColor="@color/trueGray_50"
                android:text="Ingin menghapus akun Kerjaloka? "/>
            <TextView
                android:id="@+id/delete_acc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:textSize="10dp"
                android:textColor="@color/danger_500"
                android:text="Hapus Akun!"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/activated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Material3.Button"
            android:fontFamily="@font/poppins_medium"
            android:text="Aktifkan"
            android:textSize="14dp"
            android:layout_marginBottom="10dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:fontFamily="@font/poppins_medium"
            android:text="Logout"
            android:textSize="14dp"
            app:strokeColor="@color/danger_500"/>
    </LinearLayout>


</LinearLayout>