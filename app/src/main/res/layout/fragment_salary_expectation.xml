<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    tools:context=".ui.ProfilePage.Preference.FragmentSalaryExpectation"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/mainAppbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button.Icon"
                android:layout_width="50dp"
                android:id="@+id/back_btn"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:backgroundTint="@color/white"
                android:paddingLeft="16dp"
                app:cornerRadius="100sp"
                app:icon="@drawable/ic_arrow_left_red"
                app:iconTint="@color/danger_500" />

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/mainToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:title="Edit Ekspektasi Gaji"
                app:titleTextColor="@color/black" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <RelativeLayout
        android:id="@+id/show_sheet_salary_expectation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:orientation="vertical"
        android:text="Withdraw Job"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_alignParentTop="true"
            android:orientation="vertical"
            tools:ignore="MissingConstraints">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:fontFamily="@font/poppins"
                android:paddingTop="0dp"
                android:text="Berapa ekspektasi gaji yang kamu inginkan ?"
                android:textColor="@color/black"
                android:textSize="14dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginBottom="20dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="20dp">
                <EditText
                    android:id="@+id/salary_expectation_txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:height="40dp"
                    android:background="@color/light_300"
                    android:fontFamily="@font/poppins"
                    android:hint="Masukkan ekspektasi gaji"
                    android:inputType="number"
                    android:paddingVertical="10dp"
                    android:lines="8"
                    android:textSize="14dp" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:id="@+id/action_container"
        android:layout_alignParentBottom="true"
        android:paddingVertical="5dp"
        >
        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:backgroundTint="@color/danger_500"
            android:fontFamily="@font/poppins"
            android:text="Simpan"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:cornerRadius="100dp" />
    </LinearLayout>
    </RelativeLayout>
</LinearLayout>
